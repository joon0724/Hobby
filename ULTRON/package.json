{
  "name": "ultron-crimson-core",
  "private": true,
  "version": "3.2.2",
  "description": "Ultron personal desktop voice widget",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node --env-file-if-exists=.env.local scripts/dev.mjs",
    "validate": "node scripts/validate-artifact.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop": "node scripts/build.mjs && electron .",
    "package:windows": "node scripts/package-desktop.mjs",
    "pretest": "npm run build",
    "format": "prettier --write desktop ui worker shared scripts tests package.json README.md",
    "package:windows:signed": "node scripts/package-desktop.mjs --signed",
    "verify:package": "node scripts/verify-package.mjs",
    "test:live": "node --env-file-if-exists=.env.live.local scripts/live-api-check.mjs",
    "build:hosting": "node scripts/build.mjs --hosting",
    "hosting:configure": "node scripts/configure-hosting.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "electron": "45.2.1",
    "prettier": "3.9.10",
    "@electron/windows-sign": "2.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  }
}
